  "arguments": {
    "pour": [
      {
        "group": "SOC",
        "organeRef": "PO845419",
        "text": "Le texte étend la prescription glissante aux victimes majeures et crée une infraction spécifique d'inceste."
      },
      {
        "group": "DR",
        "organeRef": "PO845425",
        "text": "Le texte instaure un socle minimal d'investigations, avec auditions rapides, recherche de preuves et identification d'autres victimes."
      },
      {
        "group": "RN",
        "organeRef": "PO845401",
        "text": "Le texte consolide les actes d'enquête, crée de nouvelles incriminations et aggrave certaines peines."
      }
    ],
    "contre": [],
    "abstention": [
      {
        "group": "LFI-NFP",
        "organeRef": "PO845413",
        "text": "Le texte ne protège pas les femmes étrangères victimes de violences contre le risque d'une OQTF après une plainte."
      },
      {
        "group": "LFI-NFP",
        "organeRef": "PO845413",
        "text": "Le texte ne prévoit aucune prise en charge des auteurs de violences ni de prévention."
      },
      {
        "group": "LFI-NFP",
        "organeRef": "PO845413",
        "text": "Le texte n'est pas assorti d'un budget suffisant et ne prend pas en charge les soins des victimes majeures."
      }
    ],
