  "arguments": {
    "pour": [
      {
        "group": "RN",
        "organeRef": "PO845401",
        "text": "Le texte donne aux acheteurs publics une liberté, là où ils doivent aujourd'hui recourir à la clause environnementale pour favoriser des offres créant de l'emploi en France."
      },
      {
        "group": "RN",
        "organeRef": "PO845401",
        "text": "Le texte apporte de la lisibilité, en indiquant que les acheteurs publics peuvent accorder une priorité aux offres dont les moyens d'exécution sont localisés en France."
      }
    ],
    "contre": [
      {
        "group": "LFI-NFP",
        "organeRef": "PO845413",
        "text": "Le texte ne crée aucune obligation et n'aurait aucun effet concret, sans critères sociaux sur l'emploi maintenu ou les salaires."
      },
      {
        "group": "GDR",
        "organeRef": "PO845514",
        "text": "Le texte se limite à la localisation des moyens d'exécution et ne fixe aucune condition sociale, environnementale ou de formation pour les entreprises."
      },
      {
        "group": "LIOT",
        "organeRef": "PO845485",
        "text": "Le texte introduit un critère contraire au principe d'égalité de traitement et de libre accès aux marchés publics, ce qui le rend inapplicable."
      }
    ],
