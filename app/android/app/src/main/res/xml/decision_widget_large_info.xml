<?xml version="1.0" encoding="utf-8"?>
<!-- Grand widget (4 x 4) : les trois dernières décisions. Rafraîchi comme le
     moyen (voir decision_widget_info.xml), d'où updatePeriodMillis à 0. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/decision_widget_large_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="250dp"
    android:previewLayout="@layout/decision_widget_large_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
