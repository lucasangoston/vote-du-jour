<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du petit widget dans le sélecteur (Android 12+), avec un exemple
     (charte Hémicycle, #29). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/decision_widget_preview_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/decision_widget_preview_arc_adopte" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:text="Adopté"
            android:textColor="@color/decision_widget_pour"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:text="Juges spécialisés pour les violences sexuelles et intrafamiliales"
        android:textColor="@color/decision_widget_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Il y a 5 jours"
        android:textColor="@color/decision_widget_secondary"
        android:textSize="11.5sp" />
</LinearLayout>
