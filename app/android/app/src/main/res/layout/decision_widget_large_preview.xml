<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du grand widget dans le sélecteur (Android 12+), avec des exemples.
     Pas de badge « Rejeté » : un seul fond de badge existe, l'aperçu reste
     indicatif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/decision_widget_preview_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DERNIÈRES DÉCISIONS"
        android:textColor="@color/decision_widget_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/decision_widget_preview_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="✓ Adopté"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="Adapter l'autorité judiciaire à la lutte contre les violences sexuelles et intrafamiliales"
        android:textColor="@color/decision_widget_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/decision_widget_preview_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="✓ Adopté"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="Moderniser et rééquilibrer le fonctionnement du titre-restaurant"
        android:textColor="@color/decision_widget_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/decision_widget_preview_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="✓ Adopté"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="Assouplir la procédure d'autorisation des établissements médico-sociaux expérimentaux"
        android:textColor="@color/decision_widget_primary"
        android:textSize="14sp" />
</LinearLayout>
