<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de lancement (Android 10 et 11) : fond de la charte et logo Perchoir centré.
     Android 12 et plus utilisent l'écran de démarrage système (values-v31). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="120dp"
        android:height="60dp"
        android:drawable="@drawable/launch_logo"
        android:gravity="center" />
</layer-list>
