<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du petit widget dans le sélecteur (Android 12+), avec un exemple (#78) : hémicycle
     coloré par le vote, résultat, titre court. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/decision_widget_preview_background"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/decision_widget_preview_hemicycle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:text="Adopté"
        android:textColor="@color/decision_widget_pour"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="Juges des violences sexuelles"
        android:textColor="@color/decision_widget_primary"
        android:textSize="14sp" />
</LinearLayout>
